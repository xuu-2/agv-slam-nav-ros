<launch>
    <arg name="repeat" default="false" />
    <!-- 设置地图的配置文件 -->
    <!-- <arg name="map" default="nav.yaml" /> -->
    <!-- 运行地图服务器，并且加载设置的地图-->
    <!-- <node name="map_server" pkg="map_server" type="map_server" args="$(find nav)/map/$(arg
    map)"/> -->
            <!-- odom_combined是由发布的里程计话题 -->
    <arg name="odom_frame_id" default="odom_combined" />
    
    <include file ="$(find hq_car_description)/launch/car.launch">
    </include>

    <!-- 开启激光雷达控制节点 -->
    

    <!-- 将3D点云转换成2D -->
    <include file = "$(find pointcloud_to_laserscan)/launch/point_to_scan.launch">
    </include>

    <!-- 开启IMU控制节点发布imu的TF变换 -->
    <include file = "$(find wit_ros_imu)/launch/display_and_imu.launch">     
    </include>

    <!-- 扩张卡尔曼滤波 发布odom_combined到footprint的TF,即小车定位 使用cartographer算法时不使用该滤波算法-->
    <include file="$(find car_top)/launch/include/ros_pose_ekf.launch"
        unless="$(arg repeat)">
        <!-- 果 repeat 参数的值为 true 或者非空字符串，那么 robot_pose_ekf.launch 将不会被包含。换句话说，
        只有在 repeat 参数为 false 或者空字符串时，robot_pose_ekf.launch 才会被包含进来。 -->
        <!-- <arg name="is_cartographer" value="$(arg is_cartographer)" /> -->
    </include>

    <include file="$(find car_top)/launch/include/read_map.launch">
    </include>

    <!-- 启动AMCL节点 -->
    <include file="$(find nav)/launch/include/amcl.launch">
    </include>

    <!-- 运行move_base功能包 -->
    <include file="$(find nav)/launch/include/move_base.launch">
    </include>

</launch>